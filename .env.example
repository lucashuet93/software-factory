# Software Factory configuration. Copy to .env and fill in values.
# Foundry authentication uses Microsoft Entra ID: run `az login --tenant <tenant-id>` first.

# Foundry (required). Create a Foundry project, deploy a chat model in it (for example gpt-5.1),
# and paste the project endpoint and the deployment name below.
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=
AZURE_TENANT_ID=
AZURE_TOKEN_CREDENTIALS=dev

# Optional
SOFTWARE_FACTORY_AGENT_NAME=software-factory-lead
SOFTWARE_FACTORY_HOME=
LOG_LEVEL=INFO

# Video calls with the lead engineer (optional). Calls use Azure Voice Live on the Foundry resource behind
# AZURE_AI_PROJECT_ENDPOINT, which must be in a region that supports avatars. Voice Live models are managed, so no
# extra model deployment is needed. Set VOICE_LIVE_ENDPOINT to use another Foundry resource, for example
# https://<resource>.services.ai.azure.com
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# Standard video avatar as <character>-<style>, for example lisa-casual-sitting, harry-business, or max-casual.
# Calls use a 1920x1080 frame, so avatar styles that render only in portrait (such as lisa-business-sitting) fail.
VOICE_LIVE_AVATAR=lisa-casual-sitting

# First test project (development and live tests only).
# Use a disposable, EMPTY repository owned by your personal account.
# Classic PAT with the `repo` and `project` scopes.
SF_TEST_REPO_URL=https://github.com/<your-user>/<empty-repo>
SF_TEST_GITHUB_PAT=
